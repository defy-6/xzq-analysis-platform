.DS_Store
**/.DS_Store

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Reasonix 工具本地状态（每人本地不同，不入库）
.reasonix/
reasonix.toml

# Dependencies and package-manager caches
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/cache/

# Build and framework output
**/.next/
**/.vinext/
**/.wrangler/
**/dist/
**/out/
**/coverage/
**/outputs/
**/work/
**/*.tsbuildinfo

# Local environment and credentials
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Large source datasets remain local; generated web interfaces are versioned.
data/raw/


# Python caches
**/__pycache__/
*.pyc

# Runtime state
运行日志/*.pid
**/.pnpm-store/

# 整机迁移打包输出（拷到新电脑用，不入库）
迁移打包/

# 大导出文件（可重新生成，不入库）
data/processed/contact-network/
